# Copiar este archivo como ".env" y completar con los datos reales.
# No versionar el archivo ".env" (agregarlo a .gitignore).

# Cadena de conexion SQLAlchemy. Ejemplos:
#   PostgreSQL: postgresql+psycopg2://usuario:password@host:5432/nombre_base
#   MySQL:      mysql+pymysql://usuario:password@host:3306/nombre_base
#   SQL Server: mssql+pyodbc://usuario:password@host:1433/nombre_base?driver=ODBC+Driver+17+for+SQL+Server
#   SQLite:     sqlite:///ruta/al/archivo.db
DB_URL=sqlite:///ejemplo.db

# Tablas disponibles en la base de datos, separadas por coma.
DB_TABLAS=ventas,clientes,productos

# Tipo de reporte que se quiere mostrar (ventas, recursos_humanos, inventario, etc.)
TIPO_REPORTE=ventas
